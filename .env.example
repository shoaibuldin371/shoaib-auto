# ==============================================================================
# ReachOut AI Automation System — Environment Configuration Template
# Copy this file to .env and fill in your actual values. Never commit .env.
# ==============================================================================

# Supabase Database & Auth (Free tier at supabase.com)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gmail SMTP/IMAP Configuration
# User Email: Mshoaibuldin371@gmail.com
# App Password: 16-character code generated from https://myaccount.google.com/apppasswords
GMAIL_USER=Mshoaibuldin371@gmail.com
GMAIL_APP_PASSWORD=

# Encryption Secret for storing passwords securely on server (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-encryption-key
ENCRYPTION_SECRET=your-32-byte-hex-encryption-key

# Google Gemini API (Free key from https://aistudio.google.com)
GEMINI_API_KEY=

# Telegram Bot Instant Reply Alerts (Optional)
# Create a bot via @BotFather and get chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduled Cron Security Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=reachout-cron-secret-change-me

# Server & App URLs
PORT=5000
VERCEL_APP_URL=https://shoaib-auto.vercel.app
NODE_ENV=development

